# ==============================================================================
# CreatorPilot - Free Environment Configuration
# 100% Free & Open Source Stack (Zero Paid Services, Zero Credit Card Required)
# ==============================================================================

# Backend Service Port & Host
PORT=8000
HOST=0.0.0.0

# LLM Reasoning & Vision (100% Free Tier)
# Get a free API key at: https://aistudio.google.com (Free tier: 15 RPM, 1M TPM, 1,500 RPD)
GEMINI_API_KEY=

# Local Ollama Fallback (Optional - automatic failover when rate limited or offline)
# Install for free from: https://ollama.ai
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# YouTube Community Agent (Free Tier: 10,000 units/day)
# If left blank, CreatorPilot runs in Demo Mode with rich sample comments
YOUTUBE_API_KEY=

# Demo Mode (true enables offline static mock data and instant zero-config exploration)
DEMO_MODE=true

# Frontend API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=true
